# Copy to .env and replace the demo password before any real deployment.
# Never commit a filled-in .env file.
ENVIRONMENT=demo

# Local development uses SQLite. Hosted deployments should supply a PostgreSQL
# URL through the provider (postgres:// and postgresql+psycopg:// both work).
DATABASE_URL=sqlite:///./mina_minks.db
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Demo-only staff credentials. The environment value is the source of truth.
ADMIN_EMAIL=mina@example.com
ADMIN_PASSWORD=demo-password-change-me
ADMIN_SESSION_TTL_MINUTES=480

SLOT_INCREMENT_MINUTES=30
BOOKING_LEAD_TIME_MINUTES=30
BOOKING_HORIZON_DAYS=60
BUSINESS_TIMEZONE=Africa/Accra

MAX_LOGIN_ATTEMPTS_PER_MINUTE=10
MAX_BOOKING_REQUESTS_PER_MINUTE=30
